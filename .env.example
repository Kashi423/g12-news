# Copy this file to `.env` in the repo root. Both apps and Prisma read that one file.

# --- Required ---------------------------------------------------------------------------------

# PostgreSQL connection string (used by Prisma in apps/web and apps/worker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/g12news"

# --- AI: set ONE of these two keys ------------------------------------------------------------

# FREE: Groq (get a key at https://console.groq.com > API Keys; no credit card needed).
# When only this key is set, the worker uses Groq and a gentler free-tier ingestion profile.
GROQ_API_KEY=""

# PAID: Anthropic Claude (https://console.anthropic.com). Better quality, roughly $2-10 a day.
ANTHROPIC_API_KEY=""

# --- Optional ---------------------------------------------------------------------------------

# Force a provider when both keys are set: "groq" or "anthropic".
# AI_PROVIDER=groq

# Groq models to use, best first, comma-separated. The free plan gives each model its own daily
# budget, so listing more models means more stories per day. Default: openai/gpt-oss-120b,openai/gpt-oss-20b
# (check https://console.groq.com/docs/rate-limits for what your plan offers)
# GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"

# Claude model when using Anthropic (default: claude-opus-5). Cheaper: "claude-sonnet-5" or "claude-haiku-4-5".
# AI_MODEL="claude-opus-5"

# Redis: when set, ingestion is scheduled as a BullMQ repeatable job (Redis 6.2+ recommended).
# Leave it unset and the worker schedules itself in-process with node-cron.
# REDIS_URL="redis://localhost:6379"

# Public address of the site, for canonical links, the sitemap, robots.txt, structured data and social-sharing
# tags. REQUIRED in production, or all of them will say http://localhost:3000.
# SITE_URL="https://g12news.com"

# Search Console / Bing Webmaster Tools ownership: the "content" value of the verification meta tag they give
# you (only the value). Optional: DNS verification works without it.
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# Your real social profile addresses. They appear in the footer and in the site's structured data; a network
# you leave unset is simply left out (nothing is invented).
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/yourpage"
# NEXT_PUBLIC_X_URL="https://x.com/yourhandle"
# NEXT_PUBLIC_WHATSAPP_URL="https://whatsapp.com/channel/..."

# Email address shown on the Contact page (for corrections, takedown requests and feedback). Nothing is
# shown until you set it, and it is baked into the page when the site is built, so rebuild after changing it.
# CONTACT_EMAIL="editor@example.com"

# Admin dashboard (/admin). Do not edit these by hand: run `npm run admin:setup`, which asks for your email and
# a password and writes ADMIN_EMAIL, ADMIN_PASSWORD_HASH (a one-way hash), ADMIN_SESSION_SECRET (random, 32+ characters)
# and HEALTH_CHECK_TOKEN here. Until they exist, /admin only shows a "not set up yet" notice.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD_HASH=""
# ADMIN_SESSION_SECRET=""
# Lets an uptime monitor poll GET /api/admin/health?token=... and warn you when the pipeline stops (README: Admin dashboard).
# Without it that endpoint does not exist.
# HEALTH_CHECK_TOKEN=""

# Cap on pooled database connections (driver default: 10). On a serverless host (Netlify) each
# function invocation can open its own connection, so managed Postgres providers with a connection
# limit (Neon, Supabase...) want this kept low; use the provider's POOLED connection string for
# DATABASE_URL too (Neon: the "-pooler" host) so many short-lived functions don't exhaust Postgres's
# own connection limit.
# DATABASE_POOL_MAX=5

# --- Netlify deployment (apps/web/netlify/functions) ---------------------------------------------

# Shared secret between trigger-ingest.mts (a scheduled function, fires every 30 min) and
# ingest-background.mts (does the actual RSS -> AI -> publish -> social pass, up to 15 min budget).
# Required for scheduled ingestion to work on Netlify; irrelevant for local/worker-process deployments.
# Generate one with `openssl rand -hex 32` or similar.
# INGEST_TRIGGER_SECRET=""

# Ingestion tuning. Defaults differ by provider: Groq (free) = every 30 min, 5 new items per run,
# 3 per source; Claude = every 15 min, 8 per source, no per-run limit.
# INGEST_INTERVAL_MINUTES=30        # how often a pass runs: 10, 12, 15, 20, 30 or 60
# INGEST_MAX_ITEMS_PER_RUN=5        # new items sent to the AI per pass across all sources (0 = no limit)
# INGEST_MAX_ITEMS_PER_SOURCE=3     # new items sent to the AI per source per pass
# INGEST_MAX_ITEM_AGE_HOURS=24      # ignore feed items older than this
# INGEST_AI_CONCURRENCY=3           # simultaneous AI requests (Groq requests are sent one at a time regardless)
# INGEST_ON_START=true              # cron mode only: run one pass at start-up (false to disable)
# INGEST_USER_AGENT=                # User-Agent sent when fetching feeds
